{
  "name": "@djson9/magic-edit",
  "version": "0.4.0",
  "description": "Shared web and React Native element selector for contextual ACP Web feedback.",
  "type": "module",
  "main": "./dist/magic-edit.js",
  "module": "./dist/magic-edit.js",
  "browser": "./dist/magic-edit.js",
  "bin": {
    "magic-edit-deploy": "./bin/magic-edit-deploy",
    "magic-edit-receive": "./bin/magic-edit-receive",
    "magic-edit-register-remote": "./bin/magic-edit-register-remote"
  },
  "exports": {
    ".": "./dist/magic-edit.js",
    "./magic-edit.js": "./dist/magic-edit.js",
    "./react-native": {
      "types": "./react-native/index.tsx",
      "react-native": "./dist/react-native.cjs",
      "default": "./dist/react-native.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "host",
    "ios",
    "react-native",
    "DJSON9MagicEdit.podspec",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && vitest run",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djson9/magic-edit.git"
  },
  "homepage": "https://github.com/djson9/magic-edit#readme",
  "bugs": {
    "url": "https://github.com/djson9/magic-edit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
